<?xml version="1.0" encoding="UTF-8"?>
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-gameboy-rom">
    <comment>Game Boy cartridge</comment>
    <glob pattern="*.gb"/>
  </mime-type>
  <mime-type type="application/x-gameboy-color-rom">
    <comment>Game Boy Color cartridge</comment>
    <glob pattern="*.gbc"/>
  </mime-type>
  <mime-type type="audio/x-gbs">
    <comment>Game Boy music</comment>
    <glob pattern="*.gbs"/>
    <magic priority="50">
      <match type="string" offset="0" value="GBS\x01"/>
    </magic>
  </mime-type>
</mime-info>
